<?xml version="1.0"?>
<?xml-model href="http://downloads.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">

    <!-- Initial package configuration -->
    <name>sentinel_interfaces</name>
    <version>1.0.0</version>
    <description>Sentinel Interfaces package to build and add to the system all the msgs needed to work with all topics ( pub / sub, services and actions )</description>
    <maintainer email="ivan.oroz34@gmail.com">Nidhood</maintainer>    <!-- Please help me adding your maintainer info ( Vales - Sofis - Elkins ) -->
    <license>BSD-3-Clause</license>

    <!-- Build tool dependencies for ament package -->
    <buildtool_depend>ament_cmake</buildtool_depend>
    <buildtool_depend>rosidl_default_generators</buildtool_depend>

    <!-- Dependencies -->
    <depend>std_msgs</depend>
    <depend>geometry_msgs</depend>

    <!-- Exec dependencies -->
    <exec_depend>rosidl_default_runtime</exec_depend>

    <!-- Others -->
    <member_of_group>rosidl_interface_packages</member_of_group>

    <!-- Exported targets -->
    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>