<?xml version="1.0"?>
<?xml-model href="http://downloads.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">

    <!-- Initial package configuration -->
    <name>sentinel_control</name>
    <version>1.0.0</version>
    <description>Sentinel control package to ensure &amp; enhance all controllers quality requirements ( e.g. time to complete a mission, minimum navigation error allowance and correction, camera precision, etc. )</description>
    <maintainer email="ivan.oroz34@gmail.com">Nidhood</maintainer>    <!-- Please help me adding your maintainer info ( Vales - Sofis - Elkins ) -->
    <license>BSD-3-Clause</license>

    <!-- Build tool dependencies for ament package -->
    <buildtool_depend>ament_cmake</buildtool_depend>

    <!-- Dependencies -->
    <depend>rclcpp</depend>
    <depend>geometry_msgs</depend>
    <depend>sensor_msgs</depend>
    <depend>std_msgs</depend>
    <depend>sentinel_interfaces</depend>

    <!-- Exec dependencies -->
    <exec_depend>controller_manager</exec_depend>
    <exec_depend>joint_state_broadcaster</exec_depend>
    <exec_depend>position_controllers</exec_depend>
    <exec_depend>gz_ros2_control</exec_depend>
    <exec_depend>launch_ros</exec_depend>

    <!-- Exported targets -->
    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>