<?xml version="1.0"?>
<?xml-model href="http://downloads.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">

  <!-- Initial package configuration -->
  <name>sentinel_description</name>
  <version>1.0.0</version>
  <description>Sentinel description package of the robot</description>
  <maintainer email="ivan.oroz34@gmail.com">Nidhood</maintainer>  <!-- Please help me adding your maintainer info ( Vales - Sofis - Elkins ) -->
  <license>BSD-3-Clause</license>

  <!-- Build tool dependencies for ament package -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Exec dependencies -->
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>sentinel_control</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <!-- Exported targets -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
