<?xml version="1.0"?>
<?xml-model href="http://downloads.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">

  <!-- Initial package configuration -->
  <name>sentinel_bridge</name>
  <version>1.0.0</version>
  <description>Sentinel bridge package that allows to communicate with multiple robot's environments for testing and working ( like GZ msgs &amp; MuJoco msgs )</description>
  <maintainer email="ivan.oroz34@gmail.com">Nidhood</maintainer>  <!-- Please help me adding your maintainer info ( Vales - Sofis - Elkins ) -->
  <license>BSD-3-Clause</license>

  <!-- Build tool dependencies for ament package -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Dependencies -->
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>ros_gz_interfaces</depend>
  <depend>sentinel_interfaces</depend>

  <!-- Exec dependencies -->
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- Exported targets -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
